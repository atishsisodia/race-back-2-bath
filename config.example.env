# Copy to config.env and fill in. Loaded by the systemd service.

# Your Traccar server, as seen from this machine (same server -> localhost is fine)
TRACCAR_URL=http://localhost:8082
# A READ-ONLY Traccar user that can only see the race devices (see README)
TRACCAR_EMAIL=spectator-feed@example.com
TRACCAR_PASSWORD=change-me

RACE_NAME=Race Back 2 Bath
# Official start time, with timezone (GMT in winter = +00:00, BST in summer = +01:00)
RACE_START=2026-11-28T09:00:00+00:00

# Names of the geofences you draw in Traccar
START_GEOFENCE=Start
FINISH_GEOFENCE=Finish
# Fallback finish point if no Finish geofence exists (University of Bath)
FINISH_LAT=51.3782
FINISH_LNG=-2.3264

# Delay spectator positions for privacy (0 = live). Organisers use Traccar directly.
DELAY_MINUTES=10
# How often to ask Traccar for new data (seconds)
POLL_SECONDS=15
# Show a "no signal" warning after this many minutes without an update
STALE_MINUTES=10

HOST=127.0.0.1
PORT=8090
